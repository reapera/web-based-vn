{
  "title": "After School",
  "start": "intro",
  "scenes": {
    "intro": {
      "background": "classroom",
      "music": "daytime",
      "steps": [
        { "type": "say", "text": "The last lecture ended ten minutes ago, but the hall isn't empty yet." },
        { "type": "enter", "actor": "eileen", "pos": "centerLeft", "emotion": "neutral", "anim": "slideInLeft" },
        { "type": "say", "actor": "eileen", "text": "I knew I'd find you here. You always stay late on Fridays." },
        { "type": "enter", "actor": "sylvie", "pos": "centerRight", "emotion": "happy", "anim": "slideInRight" },
        { "type": "say", "actor": "sylvie", "text": "Guilty. The library closes early and this is the quietest spot left." },
        { "type": "play", "actor": "eileen", "anim": "hop" },
        { "type": "say", "actor": "eileen", "emotion": "happy", "text": "Then you're free! Come on, the summer festival starts tonight." },
        { "type": "sfx", "name": "knock" },
        { "type": "play", "actor": "sylvie", "anim": "shake", "intensity": 6, "wait": true },
        { "type": "say", "actor": "sylvie", "emotion": "surprised", "text": "Tonight?! I haven't finished the physics assignment..." },
        {
          "type": "choice",
          "prompt": "What should Eileen say?",
          "options": [
            { "text": "\"Homework can wait. Fireworks can't.\"", "goto": "festival" },
            { "text": "\"Then let's finish it together, fast.\"", "goto": "study" }
          ]
        }
      ]
    },
    "festival": {
      "steps": [
        { "type": "play", "actor": "eileen", "anim": "bounce" },
        { "type": "say", "actor": "eileen", "emotion": "happy", "text": "Homework can wait. Fireworks can't!" },
        { "type": "say", "actor": "sylvie", "emotion": "smile", "text": "If I fail this class, I'm telling Professor Tanaka it was your idea." },
        { "type": "say", "actor": "eileen", "text": "Deal. Now let's go before the food stalls sell out." },
        { "type": "exit", "actor": "eileen", "anim": "slideOutLeft" },
        { "type": "exit", "actor": "sylvie", "anim": "slideOutLeft" },
        { "type": "sfx", "name": "whoosh" },
        { "type": "bg", "name": "campus", "transition": "fade", "duration": 1200 },
        { "type": "say", "text": "They cut across the empty campus, past festival posters fluttering on every lamppost." },
        { "type": "enter", "actor": "sylvie", "pos": "center", "emotion": "happy", "anim": "fadeIn" },
        { "type": "say", "actor": "sylvie", "text": "Okay. Okay, fine. This was worth it." },
        { "type": "jump", "goto": "ending" }
      ]
    },
    "study": {
      "steps": [
        { "type": "say", "actor": "eileen", "emotion": "neutral", "text": "Then let's finish it together, fast. Two brains, one assignment." },
        { "type": "play", "actor": "sylvie", "anim": "nod", "wait": true },
        { "type": "say", "actor": "sylvie", "emotion": "smile", "text": "...You hate physics. You really want to go to this festival, huh?" },
        { "type": "say", "actor": "eileen", "emotion": "happy", "text": "More than anything. Page forty-two, problem one. Go." },
        { "type": "say", "text": "Forty minutes of frantic scribbling later..." },
        { "type": "sfx", "name": "chime" },
        { "type": "play", "actor": "sylvie", "anim": "bounce" },
        { "type": "say", "actor": "sylvie", "emotion": "happy", "text": "Done! Last one to the meadow buys the takoyaki!" },
        { "type": "exit", "actor": "sylvie", "anim": "slideOutRight" },
        { "type": "exit", "actor": "eileen", "anim": "slideOutRight" },
        { "type": "bg", "name": "campus", "transition": "wipe", "duration": 1000 },
        { "type": "say", "text": "The sun is low by the time they cross the campus gates, but they made it." },
        { "type": "jump", "goto": "ending" }
      ]
    },
    "ending": {
      "steps": [
        { "type": "bg", "name": "meadowNight", "transition": "fade", "duration": 1600 },
        { "type": "music", "name": "nighttime", "fade": 1500 },
        { "type": "enter", "actor": "eileen", "pos": "centerLeft", "emotion": "happy", "anim": "fadeIn" },
        { "type": "enter", "actor": "sylvie", "pos": "centerRight", "emotion": "happy", "anim": "fadeIn" },
        { "type": "sfx", "name": "thud" },
        { "type": "play", "actor": "eileen", "anim": "pulse" },
        { "type": "play", "actor": "sylvie", "anim": "pulse" },
        { "type": "say", "text": "The first firework blooms over the hills, gold against the dark." },
        { "type": "say", "actor": "sylvie", "emotion": "smile", "text": "Same time next year?" },
        { "type": "say", "actor": "eileen", "text": "Same time every year." },
        { "type": "end" }
      ]
    }
  }
