  },
  {
    "id": "narration_1",
    "type": "dialogue",
    "character": null,
    "text": "After the last bell, the hallway emptied — except for the two of them.",
    "next": "lyrel_1"
  },
  {
    "id": "lyrel_1",
    "type": "dialogue",
    "character": "Lyrel",
    "text": "You're still here? I thought you had somewhere to be.",
    "next": "eve_1"
  },
  {
    "id": "eve_1",
    "type": "dialogue",
    "character": "Eve",
    "text": "Plans changed. Got a problem with that?",
    "next": "lyrel_2"
  },
  {
    "id": "lyrel_2",
    "type": "dialogue",
    "character": "Lyrel",
    "text": "Not at all. I just figured you'd be long gone by now.",
    "next": "eve_2"
  },
  {
    "id": "eve_2",
    "type": "dialogue",
    "character": "Eve",
    "text": "Well. I'm still here.",
    "next": "lyrel_3"
  },
  {
    "id": "lyrel_3",
    "type": "dialogue",
    "character": "Lyrel",
    "text": "There's a café near the station. I was heading there. You could... come along. If you wanted.",
    "next": "eve_3"
  },
  {
    "id": "eve_3",
    "type": "dialogue",
    "character": "Eve",
    "text": "Is that actually an invitation or are you just thinking out loud?",
    "next": "lyrel_4"
  },
  {
    "id": "lyrel_4",
    "type": "dialogue",
    "character": "Lyrel",
    "text": "Take it however you want.",
    "next": "choice_1"
  },
  {
    "id": "choice_1",
    "type": "choice",
    "choices": [
      { "label": "\"Fine. Let's go.\"", "goto": "accept_1" },
      { "label": "\"Maybe another time.\"", "goto": "decline_1" }
    ]
  },
  {
    "id": "accept_1",
    "type": "dialogue",
    "character": "Eve",
    "text": "Don't make it weird. I just don't want to go home yet.",
    "next": "lyrel_accept"
  },
  {
    "id": "lyrel_accept",
    "type": "dialogue",
    "character": "Lyrel",
    "text": "Sure. That's definitely the reason.",
    "next": "narration_good"
  },
  {
    "id": "narration_good",
    "type": "dialogue",
    "character": null,
    "text": "They walked out together into the afternoon light. Neither of them said much — but neither of them minded.",
    "next": "end"
  },
  {
    "id": "decline_1",
    "type": "dialogue",
    "character": "Eve",
    "text": "Maybe another time.",
    "next": "lyrel_decline"
  },
  {
    "id": "lyrel_decline",
    "type": "dialogue",
    "character": "Lyrel",
    "text": "Right. See you around then.",
    "next": "narration_neutral"
  },
  {
    "id": "narration_neutral",
    "type": "dialogue",
    "character": null,
    "text": "She watched him disappear around the corner, wondering if she'd made the wrong call.",
    "next": "end"
  },
  {
    "id": "end",
    "type": "end"
  }
]
