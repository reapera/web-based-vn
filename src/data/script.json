    "next": "sprite_eve"
  },
  {
    "id": "sprite_eve",
    "type": "sprite",
    "character": "Eve",
    "src": "/sprites/eve.png",
    "position": "right",
    "next": "sprite_lyrel"
  },
  {
    "id": "sprite_lyrel",
    "type": "sprite",
    "character": "Lyrel",
    "src": "/sprites/lyrel.png",
    "position": "left",
    "next": "narration_1"
  },
  {
    "id": "narration_1",
    "type": "dialogue",
    "character": null,
    "text": "The hallway was empty. Lyrel had been waiting for nearly ten minutes.",
    "next": "lyrel_nervous"
  },
  {
    "id": "lyrel_nervous",
    "type": "dialogue",
    "character": "Lyrel",
    "emotion": "nervous",
    "text": "She's late... Did I get the time wrong? Did I get the day wrong?",
    "next": "eve_shocked"
  },
  {
    "id": "eve_shocked",
    "type": "dialogue",
    "character": "Eve",
    "emotion": "shocked",
    "text": "Lyrel?! You're actually here. I thought you'd have left by now.",
    "next": "lyrel_shocked"
  },
  {
    "id": "lyrel_shocked",
    "type": "dialogue",
    "character": "Lyrel",
    "emotion": "shocked",
    "text": "I — what? You're the one who's late!",
    "next": "eve_angry"
  },
  {
    "id": "eve_angry",
    "type": "dialogue",
    "character": "Eve",
    "emotion": "angry",
    "text": "I am not late. You were just early. There's a difference.",
    "next": "lyrel_sad"
  },
  {
    "id": "lyrel_sad",
    "type": "dialogue",
    "character": "Lyrel",
    "emotion": "sad",
    "text": "I waited for you. I thought maybe you weren't coming.",
    "next": "eve_idle"
  },
  {
    "id": "eve_idle",
    "type": "dialogue",
    "character": "Eve",
    "emotion": "idle",
    "text": "...",
    "next": "eve_sad"
  },
  {
    "id": "eve_sad",
    "type": "dialogue",
    "character": "Eve",
    "emotion": "sad",
    "text": "I almost didn't. I had a rough day.",
    "next": "lyrel_nervous_2"
  },
  {
    "id": "lyrel_nervous_2",
    "type": "dialogue",
    "character": "Lyrel",
    "emotion": "nervous",
    "text": "Do you... want to talk about it? Or we could just go somewhere quiet.",
    "next": "choice_1"
  },
  {
    "id": "choice_1",
    "type": "choice",
    "choices": [
      { "label": "\"Let's go somewhere.\"", "goto": "accept_1" },
      { "label": "\"I'd rather be alone.\"", "goto": "decline_1" }
    ]
  },
  {
    "id": "accept_1",
    "type": "dialogue",
    "character": "Eve",
    "emotion": "happy",
    "text": "Yeah. That actually sounds good.",
    "next": "lyrel_happy"
  },
  {
    "id": "lyrel_happy",
    "type": "dialogue",
    "character": "Lyrel",
    "emotion": "happy",
    "text": "There's a place near the station. Hot drinks. Nobody talks too loudly.",
    "next": "eve_happy"
  },
  {
    "id": "eve_happy",
    "type": "dialogue",
    "character": "Eve",
    "emotion": "happy",
    "text": "Perfect. Lead the way.",
    "next": "narration_good"
  },
  {
    "id": "narration_good",
    "type": "dialogue",
    "character": null,
    "text": "For once, neither of them said anything difficult. It was enough.",
    "next": "end"
  },
  {
    "id": "decline_1",
    "type": "dialogue",
    "character": "Eve",
    "emotion": "angry",
    "text": "Actually — don't take this wrong — I need to be alone right now.",
    "next": "lyrel_sad_2"
  },
  {
    "id": "lyrel_sad_2",
    "type": "dialogue",
    "character": "Lyrel",
    "emotion": "sad",
    "text": "Oh. Okay. I understand.",
    "next": "narration_neutral"
  },
  {
    "id": "narration_neutral",
    "type": "dialogue",
    "character": null,
    "text": "She didn't understand. But she let her go anyway.",
    "next": "end"
  },
  {
    "id": "end",
    "type": "end"
  }
]
